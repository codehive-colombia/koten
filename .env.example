# Copy to .env and adjust for the deployment.

# Image published by the GitHub Actions workflow. Set it to
# ghcr.io/<owner>/<repo>:latest, or leave the default to build locally.
KOTEN_IMAGE=koten:local

# Public origin used in the catalog links and the shadcn registry.
KOTEN_SITE_URL=https://koten.codehive.com.co
KOTEN_HOST=koten.codehive.com.co

# Host ports published only by docker-compose.local.yml (local checks).
# The server does not publish ports; Traefik reaches the container internally.
KOTEN_DOCS_PORT=3000
KOTEN_STOREFRONT_PORT=3001
KOTEN_ERP_PORT=3002

# Traefik entrypoint and certificate resolver.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
