{
  "name": "koten",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter @koten/catalog build && bun run --filter @koten/storefront build && bun run --filter @koten/erp build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && bun run typecheck && bun run check:i18n && bun run test",
    "check:i18n": "bun scripts/check-i18n.ts",
    "qa:a11y": "bun scripts/qa-a11y.ts",
    "qa:overflow": "bun scripts/qa-overflow.ts",
    "qa:perf": "bun scripts/qa-perf.ts",
    "qa:visual": "bun scripts/qa-visual.ts",
    "registry": "bun scripts/build-registry.ts",
    "ci": "bun run check && bun run build && bun run budget",
    "budget": "bun scripts/check-budgets.ts",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
